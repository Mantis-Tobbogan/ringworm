From 721917474b4044642fb071cf1d5f5e79b534ba83 Mon Sep 17 00:00:00 2001
From: mantis-tobbogan <dhanu.andre.legend@gmail.com>
Date: Sat, 31 Oct 2026 18:37:35 +0530
Subject: [PATCH] cli: add cursor-position subcommand

niri msg cursor-position prints "x, y" (or JSON with --json), mirroring
hyprctl cursorpos so scripts can be portable.
---
 src/cli.rs        |  2 ++
 src/ipc/client.rs | 21 +++++++++++++++++++++
 2 files changed, 23 insertions(+)

diff --git a/src/cli.rs b/src/cli.rs
index 308b312..aa40af4 100644
--- a/src/cli.rs
+++ b/src/cli.rs
@@ -109,6 +109,8 @@ pub enum Msg {
     OverviewState,
     /// List screencasts.
     Casts,
+    /// Print the current cursor position.
+    CursorPosition,
 }
 
 #[derive(Clone, Debug, clap::ValueEnum)]
diff --git a/src/ipc/client.rs b/src/ipc/client.rs
index 40a58ef..36b7eb2 100644
--- a/src/ipc/client.rs
+++ b/src/ipc/client.rs
@@ -49,6 +49,7 @@ pub fn handle_msg(mut msg: Msg, json: bool) -> anyhow::Result<()> {
         Msg::RequestError => Request::ReturnError,
         Msg::OverviewState => Request::OverviewState,
         Msg::Casts => Request::Casts,
+        Msg::CursorPosition => Request::CursorPosition,
     };
 
     let mut socket = Socket::connect().context("error connecting to the niri socket")?;
@@ -506,6 +507,9 @@ pub fn handle_msg(mut msg: Msg, json: bool) -> anyhow::Result<()> {
                     Event::CastStopped { stream_id } => {
                         println!("Cast stopped: stream id {stream_id}");
                     }
+                    Event::CursorPositionChanged { position } => {
+                        println!("Cursor position changed to {position:?}");
+                    }
                 }
             }
         }
@@ -550,6 +554,23 @@ pub fn handle_msg(mut msg: Msg, json: bool) -> anyhow::Result<()> {
                 println!();
             }
         }
+        Msg::CursorPosition => {
+            let Response::CursorPosition(position) = response else {
+                bail!("unexpected response: expected CursorPosition, got {response:?}");
+            };
+
+            if json {
+                let position =
+                    serde_json::to_string(&position).context("error formatting response")?;
+                println!("{position}");
+                return Ok(());
+            }
+
+            match position {
+                Some((x, y)) => println!("{x:.1}, {y:.1}"),
+                None => println!("no cursor position known"),
+            }
+        }
     }
 
     Ok(())
-- 
2.56.0

